# Copy to .env and fill in only the integrations you intend to use.
# Never commit .env.

# --- LLM providers (optional; pipeline degrades to "pending" extraction) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- GitHub enrichment (optional, raises REST limit from 60 to 5000 req/h) ---
GITHUB_TOKEN=

# --- Google Sheets export (optional) ---
# Path to a service-account JSON key file. Keep it outside the repository.
GOOGLE_APPLICATION_CREDENTIALS=
# Existing spreadsheet id, or leave blank to create a new spreadsheet.
GOOGLE_SHEETS_SPREADSHEET_ID=
# Email to share the generated spreadsheet with (optional).
GOOGLE_SHEETS_SHARE_WITH=

# --- Runtime ---
FRONTIERATLAS_LOG_LEVEL=INFO
